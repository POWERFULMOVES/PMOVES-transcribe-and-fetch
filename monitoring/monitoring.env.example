# Monitoring Stack Environment Variables
# Copy to monitoring.env and fill in real values
# See: pmoves/docs/hardening/PMOVES-hardening-tracker.md

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GF_USERS_ALLOW_SIGN_UP=false

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_DB_PASSWORD=CHANGE_ME
LANGFUSE_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME

# AlertManager Configuration
SMTP_SMARTHOST=localhost:587
SMTP_FROM=pmoves-alerts@example.com
SMTP_AUTH_USERNAME=pmoves-alerts@example.com
SMTP_AUTH_PASSWORD=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# Monitoring Configuration
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
GRAFANA_PLUGINS=redis-datasource,prometheus

# Service URLs (adjust based on your setup)
PMOVES_BACKEND_URL=http://pmoves-backend:8000
PMOVES_PIPECAT_URL=http://pipecat:8080
PMOVES_AGENT_REGISTRY_URL=http://agent-registry:8000
LITELLM_PROXY_URL=http://litellm-proxy:4000
CRAWL4AI_URL=http://crawl4ai:11235

# Security
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=CHANGE_ME
