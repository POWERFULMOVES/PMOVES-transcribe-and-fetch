# PMOVES-transcribe-and-fetch Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Groq (fast inference)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# Perplexity AI
PERPLEXITYAI_API_KEY=pplx-your-perplexity-key-here

# Together AI
TOGETHER_AI_API_KEY=your-together-ai-key-here

# Cohere
COHERE_API_KEY=your-cohere-api-key-here

# Fireworks AI
FIREWORKS_AI_API_KEY=fw_your-fireworks-key-here

# =============================================================================
# Supabase Configuration
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# Database Configuration
# =============================================================================

POSTGRES_DB=pmoves
POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public

# Service credentials (generate secure passwords)
SERVICE_USER_ADMIN=pmovesadmin
SERVICE_PASSWORD_ADMIN=generate-secure-password-here
SERVICE_PASSWORD_POSTGRES=generate-secure-password-here

# =============================================================================
# MinIO Object Storage
# =============================================================================

MINIO_USER=pmoves
MINIO_PASSWORD=generate-secure-password-here

# =============================================================================
# Local LLM Endpoints
# =============================================================================

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-Compatible (LM Studio, Jan, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_BASE=http://localhost:1234/v1

# Crawl4AI Service
CRAWL4AI_SERVICE_URL=http://localhost:11235

# =============================================================================
# Application Settings
# =============================================================================

# Default paths
DEFAULT_OBSIDIAN_DIR=/path/to/default/obsidian/dir
DEFAULT_OUTPUT_FOLDER=/path/to/default/output

# Logging
LOG_TO_FILE=false
LOG_FILE_NAME=pmoves_backend.log

# API Keys for internal auth
VALID_API_KEYS=your-internal-api-key
NEXT_PUBLIC_BACKEND_API_KEY=your-internal-api-key

# =============================================================================
# Whisper (Local Transcription)
# =============================================================================

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
