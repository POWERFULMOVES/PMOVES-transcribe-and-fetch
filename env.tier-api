# PMOVES-transcribe-and-fetch API Tier Configuration
# ===================================================
# Credentials for backend API service.
# Copy to .env.local and fill in real values.

# ===== Supabase Configuration =====
# Obtain from your Supabase project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ===== Next.js Public Keys =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===== Internal API Authentication =====
# Generate with: openssl rand -hex 16
VALID_API_KEYS=your-internal-api-key
NEXT_PUBLIC_BACKEND_API_KEY=your-internal-api-key

# ===== PostgreSQL (for direct DB access if needed) =====
POSTGRES_DB=pmoves
POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public
