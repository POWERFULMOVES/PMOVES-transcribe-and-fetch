# Agent Registry Configuration
AGENT_REGISTRY_URL="http://localhost:8008/agents" # Adjust if your registry runs elsewhere

# Supabase Configuration
# PMOVES Supabase instance — values sourced from parent repo's secrets funnel
# See: pmoves/chit/secrets_manifest.yaml entries: supabase_url, supabase_service_key
SUPABASE_URL=${SUPABASE_URL:-http://supabase-kong:8000}
SUPABASE_KEY=${SUPABASE_SERVICE_ROLE_KEY:-your-supabase-service-role-key-here}

# Supabase Agent Specific Configuration
AGENT_ID="supabase_agent_001"
AGENT_NAME="Supabase Interaction Agent"
AGENT_DESCRIPTION="Agent for interacting with Supabase databases (querying, upserting, managing tables)."
AGENT_ENDPOINT_URL="http://localhost:8002" # The URL where this agent will be accessible
AGENT_PORT=8002 # Port on which the FastAPI app will run

# Agent Framework Configuration
HEARTBEAT_INTERVAL_SECONDS=30

# Optional: If your agent needs a specific version or has tags
AGENT_VERSION="0.1.0"
AGENT_TAGS='["database", "supabase", "data_management"]' # JSON string for list of tags
AGENT_CAPABILITIES='["supabase_interaction", "query_execution", "data_upsert", "table_management"]' # JSON string
AGENT_INPUT_SCHEMA='{"type": "object", "properties": {"command": {"type": "string"}, "parameters": {"type": "object"}}}' # JSON string
AGENT_OUTPUT_SCHEMA='{"type": "object", "properties": {"status": {"type": "string"}, "data": {"type": "object"}}}' # JSON string
AGENT_CONFIG='{"default_timeout": 60}' # JSON string for agent-specific config
AGENT_DEPENDENCIES='[]' # JSON string for list of dependencies
AGENT_STATUS="initializing" # Initial status
PYTHONPATH="/app" # To help with imports if utils is in /app/utils
LOG_LEVEL="INFO"

# Chat Listener Configuration
CHAT_INPUT_TABLE_NAME="chat_messages"
CHAT_OUTPUT_TABLE_NAME="agent_responses"
CHAT_POLL_INTERVAL_SECONDS="5"

# LiteLLM Proxy URL for LLM Registry Service (if used by this agent)
LITELLM_PROXY_URL="http://localhost:4000" # Adjust to your LiteLLM proxy instance
