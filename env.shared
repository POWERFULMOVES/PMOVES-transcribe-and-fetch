# PMOVES-transcribe-and-fetch Environment Configuration
# =====================================================
# This file contains shared defaults (git-tracked, no secrets).
# Tier files: env.tier-api, env.tier-worker, env.tier-llm, env.tier-media
# Override in .env.local for host-specific values.
# Secrets go in secrets/ directory (Docker secrets).

# ===== Deployment Mode =====
DOCKED_MODE=false
DB_BACKEND=sqlite
SUPABASE_DUAL_WRITE=false
AGENT_ZERO_MCP_ENABLED=false

# ===== Network Ports =====
# Format: HOST_PORT:INTERNAL_PORT
TRANSCRIBE_BACKEND_HOST_PORT=8000
TRANSCRIBE_BACKEND_INTERNAL_PORT=8000
TRANSCRIBE_FRONTEND_HOST_PORT=448
TRANSCRIBE_FRONTEND_INTERNAL_PORT=448
TRANSCRIBE_LITELLM_HOST_PORT=4000
TRANSCRIBE_LITELLM_INTERNAL_PORT=4000
TRANSCRIBE_CRAWL4AI_HOST_PORT=11235
TRANSCRIBE_CRAWL4AI_INTERNAL_PORT=11235
TRANSCRIBE_PIPECAT_HOST_PORT=8080
TRANSCRIBE_PIPECAT_INTERNAL_PORT=8080
TRANSCRIBE_SUPABASE_AGENT_HOST_PORT=8002
TRANSCRIBE_SUPABASE_AGENT_INTERNAL_PORT=8002

# ===== Service Discovery (Standalone Mode) =====
# These are defaults for standalone deployment.
# When DOCKED_MODE=true, override in .env.local with parent network names.
SUPABASE_URL=http://localhost:54321
SUPA_REST_URL=http://localhost:54321/rest/v1
NATS_URL=nats://nats:pmoves@localhost:4222
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_PROXY_URL=http://litellm-proxy:4000
CRAWL4AI_SERVICE_URL=http://crawl4ai:11235

# ===== Service Discovery (Docked Mode) =====
# Uncomment these when DOCKED_MODE=true
# SUPABASE_URL=http://host.docker.internal:54321
# SUPA_REST_URL=http://host.docker.internal:54321/rest/v1
# NATS_URL=nats://nats:pmoves@nats:4222
# OLLAMA_BASE_URL=http://pmoves-ollama:11434

# ===== CORS Configuration =====
CORS_ALLOWED_ORIGINS=http://localhost:448,http://127.0.0.1:448

# ===== Processing Defaults =====
LOG_TO_FILE=false
LOG_FILE_NAME=pmoves_backend.log
AUTO_MIGRATE=false

# ===== Frontend Configuration =====
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# ===== Health Check Configuration =====
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=30s
