# PMOVES-transcribe-and-fetch Media Tier Configuration
# =====================================================
# Configuration for media processing (Whisper transcription).

# ===== Whisper Configuration =====
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Alternative models:
# WHISPER_MODEL=base
# WHISPER_MODEL=small
# WHISPER_MODEL=medium
# WHISPER_MODEL=large
# WHISPER_MODEL=large-v2
# WHISPER_MODEL=large-v3 (recommended)

# Device options:
# WHISPER_DEVICE=auto
# WHISPER_DEVICE=cuda
# WHISPER_DEVICE=cpu

# Compute type options:
# WHISPER_COMPUTE_TYPE=float32 (most precise)
# WHISPER_COMPUTE_TYPE=float16 (recommended for GPU)
# WHISPER_COMPUTE_TYPE=int8 (faster, some quality trade-off)

# ===== GPU Memory Management =====
# For CUDA devices with limited memory
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ===== Hugging Face Cache =====
HF_HOME=/home/nonroot/.cache/huggingface
TORCH_HOME=/home/nonroot/.cache/torch
TRANSFORMERS_CACHE=/home/nonroot/.cache/huggingface/transformers

# ===== Output Paths =====
DEFAULT_OBSIDIAN_DIR=/app/output/obsidian
DEFAULT_OUTPUT_FOLDER=/app/output
