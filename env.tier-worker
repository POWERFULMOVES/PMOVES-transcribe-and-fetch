# PMOVES-transcribe-and-fetch Worker Tier Configuration
# ======================================================
# Configuration for background worker services.

# ===== Crawl4AI Configuration =====
CRAWL4AI_SERVICE_URL=http://crawl4ai:11235
CRAWL4AI_MAX_CONCURRENT=4
CRAWL4AI_TIMEOUT=60

# ===== Pipecat Configuration =====
PIPECAT_ENABLED=true
PIPECAT_PORT=8080

# ===== Supabase Agent Configuration =====
AGENT_ENDPOINT_URL=http://supabase-agent:8002
AGENT_REGISTRY_URL=http://backend:8000/agents

# ===== Processing Settings =====
WORKER_MAX_RETRIES=3
WORKER_TIMEOUT_SECONDS=300
WORKER_BATCH_SIZE=10
