# PMOVES-transcribe-and-fetch LLM Tier Configuration
# ===================================================
# API keys for LLM providers.
# Copy to .env.local and fill in real values.
# NEVER commit real keys to git.

# ===== Primary Providers =====
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===== Google =====
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ===== Secondary Providers =====
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
PERPLEXITYAI_API_KEY=pplx-your-perplexity-key-here
TOGETHER_AI_API_KEY=your-together-ai-key-here
COHERE_API_KEY=your-cohere-api-key-here
FIREWORKS_AI_API_KEY=fw_your-fireworks-key-here

# ===== Local LLM Endpoints =====
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_BASE=http://localhost:1234/v1

# ===== LangExtract Configuration =====
LANGEXTRACT_PROVIDER=ollama
LANGEXTRACT_MODEL=gemini-2.5-flash

# ===== Optional: Hugging Face =====
# HF_TOKEN=your_hugging_face_token_here

# ===== Optional: Nvidia NIM =====
# NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
